generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(uuid()) @db.Uuid
  name              String
  email             String          @unique
  phone             String?
  passwordHash      String          @map("password_hash")
  role              UserRole        @default(USER)
  isBlocked         Boolean         @default(false) @map("is_blocked")
  blockReason       String?         @map("block_reason")
  blockedUntil      DateTime?       @map("blocked_until")
  avatarUrl         String?         @map("avatar_url")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  carts             CartItem[]
  createdChallenges Challenge[]
  orders            Order[]
  passwordOtps      PasswordOtp[]
  approvedProducts  Product[]       @relation("ApprovedProducts")
  submittedProducts Product[]       @relation("SubmittedProducts")
  userChallenges    UserChallenge[]

  @@map("users")
}

model Problem {
  id           String  @id @default(uuid()) @db.Uuid
  title        String
  slug         String  @unique
  description  String
  thumbnailUrl String? @map("thumbnail_url")
  sortOrder    Int     @default(0) @map("sort_order")
  steps        Step[]

  @@map("problems")
}

model Step {
  id           String      @id @default(uuid()) @db.Uuid
  problemId    String      @map("problem_id") @db.Uuid
  stepNumber   Int         @map("step_number")
  title        String
  description  String
  thumbnailUrl String?     @map("thumbnail_url")
  media        StepMedia[]
  problem      Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, stepNumber])
  @@map("steps")
}

model StepMedia {
  id          String        @id @default(uuid()) @db.Uuid
  stepId      String        @map("step_id") @db.Uuid
  mediaType   StepMediaType @map("media_type")
  url         String
  title       String?
  description String?
  durationSec Int?          @map("duration_sec")
  sortOrder   Int           @default(0) @map("sort_order")
  step        Step          @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("step_media")
}

model PasswordOtp {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  codeHash   String             @map("code_hash")
  purpose    PasswordOtpPurpose
  expiresAt  DateTime           @map("expires_at")
  consumedAt DateTime?          @map("consumed_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("password_otps")
}

model Product {
  id             String                @id @default(uuid()) @db.Uuid
  submittedById  String                @map("submitted_by") @db.Uuid
  name           String
  description    String
  category       String
  unit           String
  quantity       Int
  suggestedPrice Decimal               @map("suggested_price") @db.Decimal(12, 2)
  thumbnailUrl   String?               @map("thumbnail_url")
  imageUrls      Json?                 @map("image_urls")
  approvalStatus ProductApprovalStatus @default(PENDING) @map("approval_status")
  adminNote      String?               @map("admin_note")
  approvedById   String?               @map("approved_by") @db.Uuid
  approvedAt     DateTime?             @map("approved_at")
  adminPrice     Decimal?              @map("admin_price") @db.Decimal(12, 2)
  listingPrice   Decimal?              @map("listing_price") @db.Decimal(12, 2)
  isActive       Boolean               @default(false) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  cartItems      CartItem[]
  orderItems     OrderItem[]
  approvedBy     User?                 @relation("ApprovedProducts", fields: [approvedById], references: [id])
  submittedBy    User                  @relation("SubmittedProducts", fields: [submittedById], references: [id])

  @@map("products")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  buyerId     String      @map("buyer_id") @db.Uuid
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  items       OrderItem[]
  buyer       User        @relation(fields: [buyerId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Challenge {
  id             String          @id @default(uuid()) @db.Uuid
  title          String
  detail         String
  thumbnailUrl   String?         @map("thumbnail_url")
  status         ChallengeStatus @default(DRAFT)
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  createdById    String          @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      User            @relation(fields: [createdById], references: [id])
  userChallenges UserChallenge[]

  @@map("challenges")
}

model UserChallenge {
  id             String                      @id @default(uuid()) @db.Uuid
  userId         String                      @map("user_id") @db.Uuid
  challengeId    String                      @map("challenge_id") @db.Uuid
  progressStatus UserChallengeProgressStatus @default(JOINED) @map("progress_status")
  progressPct    Int                         @default(0) @map("progress_pct")
  joinedAt       DateTime                    @default(now()) @map("joined_at")
  completedAt    DateTime?                   @map("completed_at")
  note           String?
  reviewStatus   ChallengeReviewStatus       @default(PENDING) @map("review_status")
  reviewNote     String?                     @map("review_note")
  isWinner       Boolean                     @default(false) @map("is_winner")
  rewardPaidAt   DateTime?                   @map("reward_paid_at")
  pictures       UserChallengePicture[]
  challenge      Challenge                   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("user_challenges")
}

model UserChallengePicture {
  id              String                   @id @default(uuid()) @db.Uuid
  userChallengeId String                   @map("user_challenge_id") @db.Uuid
  url             String
  caption         String?
  takenAt         DateTime                 @default(now()) @map("taken_at")
  kind            UserChallengePictureKind @default(PROGRESS)
  aiReview        String?                  @map("ai_review")
  aiIsRelevant    Boolean?                 @map("ai_is_relevant")
  aiIsFresh       Boolean?                 @map("ai_is_fresh")
  userChallenge   UserChallenge            @relation(fields: [userChallengeId], references: [id], onDelete: Cascade)

  @@map("user_challenge_pictures")
}

enum UserRole {
  USER
  ADMIN
}

enum ProductApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  COMPLETED
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum UserChallengeProgressStatus {
  JOINED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StepMediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum PasswordOtpPurpose {
  PASSWORD_RESET
  PASSWORD_CHANGE
}

enum UserChallengePictureKind {
  BEFORE
  AFTER
  PROGRESS
}

enum ChallengeReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
